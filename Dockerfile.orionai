FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir regex uvicorn fastapi nltk sentence-transformers supabase python-dotenv
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2')"
COPY src/server/OrionAI.py .
EXPOSE 8000
CMD ["uvicorn", "OrionAI:app", "--host", "0.0.0.0", "--port", "8000"]
