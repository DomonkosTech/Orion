        h2 { color: #117a8b; margin-top: 40px; border-bottom: 1px solid #dfe7eb; padding-bottom: 6px; }
        h3 { color: #17486a; margin-top: 28px; }
        h4 { color: #0d4f63; margin-top: 22px; }
        p { text-align: justify; margin-bottom: 14px; }
        ul { margin-bottom: 18px; }
        li { margin-bottom: 8px; }
        code { font-family: 'Consolas', 'Courier New', monospace; background: #eef5f8; padding: 1px 5px; border-radius: 4px; }
        pre { background: #21313c; color: #eef6fb; padding: 18px; border-radius: 8px; overflow-x: auto; line-height: 1.45; font-size: 12.5px; }
        table { border-collapse: collapse; width: 100%; margin-bottom: 22px; font-size: 0.94em; }
        th { background: #0d4f63; color: white; text-align: left; padding: 10px 12px; }
