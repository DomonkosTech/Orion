                </tr>
                <tr>
                    <td>Hirdetés</td>
                    <td>vázlat vagy új</td>
                    <td>létrehozott → aktív → módosított → lezárt / archivált</td>
                    <td>A kattintás és jelentkezésszám külön analitikai állapot</td>
                </tr>
                <tr>
                    <td>Jelentkezés</td>
                    <td>beküldött</td>
                    <td>beküldött → áttekintés alatt → kapcsolatfelvétel → elfogadott / elutasított</td>
                    <td>Az ATS legfőbb munkadarabja</td>
                </tr>
                <tr>
                    <td>Chat kapcsolat</td>
                    <td>nincs vagy inaktív</td>
                    <td>létrejött → aktív → lezárt / elhalt</td>
