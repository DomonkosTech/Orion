                        <td><strong>Stílusozás</strong></td>
                        <td><span class="tech-tag">Vanilla CSS</span></td>
                        <td>Native CSS Variables, Flexbox és Grid a maximális kontrollért.</td>
                    </tr>
                    <tr>
                        <td><strong>Állapotkezelés</strong></td>
                        <td><span class="tech-tag">Context API</span></td>
                        <td>Beépített, skálázható állapotkezelés boilerplate nélkül.</td>
                    </tr>
                    <tr>
                        <td><strong>Navigáció</strong></td>
                        <td><span class="tech-tag">React Router 7</span></td>
                        <td>Kliensoldali útvonalválasztás és Route Guard rendszer.</td>
                    </tr>
