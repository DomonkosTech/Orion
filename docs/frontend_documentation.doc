                        <td><strong>Űrlapok</strong></td>
                        <td><span class="tech-tag">React Hook Form</span></td>
                        <td>Optimális teljesítményű űrlapkezelés és validáció integráció.</td>
                    </tr>
                    <tr>
                        <td><strong>Validáció</strong></td>
                        <td><span class="tech-tag">Zod</span></td>
                        <td>Séma-alapú típusbiztonság és adatvalidáció.</td>
                    </tr>
